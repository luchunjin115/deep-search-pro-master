# Deep Search Pro M1环境变量模板
# 复制为.env后再修改；禁止把真实密码或API Key提交到Git。

# 应用基础配置
APP_NAME=Deep Search Pro M1
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL（M1-02开始使用）
POSTGRES_DB=deep_search_pro
POSTGRES_USER=deep_search_app
POSTGRES_PASSWORD=local-demo-password-change-me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://deep_search_app:local-demo-password-change-me@127.0.0.1:5433/deep_search_pro
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=2000

# 模型：M1默认使用Mock，不需要API Key
LLM_PROVIDER=mock
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=5

# 登录令牌（只用于本地开发占位，生产环境必须替换）
JWT_SECRET_KEY=local-development-only-change-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# M1合成演示账号的本地初始密码；只用于本地演示，数据库只保存Argon2哈希
M1_DEMO_PASSWORD=M1-demo-only-change-me

# M1单次运行预算：最多2次受控Tool建议（商品解析、库存查询）和2个只读Tool
EXECUTION_MAX_MODEL_CALLS=2
EXECUTION_MAX_TOOL_CALLS=2
EXECUTION_MAX_REPEAT_TOOL_CALLS=1
EXECUTION_TOTAL_TIMEOUT_MS=8000
