# Deep Search Pro M1/M2环境变量模板
# 复制为.env后再修改；禁止把真实密码或API Key提交到Git。

# 应用基础配置
APP_NAME=Deep Search Pro M1
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL（M1-02开始使用）
POSTGRES_DB=deep_search_pro
POSTGRES_USER=deep_search_app
POSTGRES_PASSWORD=local-demo-password-change-me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://deep_search_app:local-demo-password-change-me@127.0.0.1:5433/deep_search_pro
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=2000

# 模型：M1默认使用Mock，不需要API Key
LLM_PROVIDER=mock
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=5
# M2-21.8 Agent结构化输出上限；不代表可信运行预算
QWEN_AGENT_MAX_OUTPUT_TOKENS=4096
# M2 Agent可显式选择DeepSeek；旧M1 Tool Proposal路径仍只支持Mock/Qwen
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=5
DEEPSEEK_AGENT_MAX_OUTPUT_TOKENS=4096

# 登录令牌（只用于本地开发占位，生产环境必须替换）
JWT_SECRET_KEY=local-development-only-change-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# M1合成演示账号的本地初始密码；只用于本地演示，数据库只保存Argon2哈希
M1_DEMO_PASSWORD=M1-demo-only-change-me

# M1单次运行预算：最多2次受控Tool建议（商品解析、库存查询）和2个只读Tool
EXECUTION_MAX_MODEL_CALLS=2
EXECUTION_MAX_TOOL_CALLS=2
EXECUTION_MAX_REPEAT_TOOL_CALLS=1
EXECUTION_TOTAL_TIMEOUT_MS=8000

# M2本地文件与模型缓存；目录由服务端管理，前端和模型不得接触绝对路径
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=data/storage
MODEL_CACHE_ROOT=data/model-cache

# M2-11.2 Docling只用于显式基准；默认关闭、CPU串行、禁止远程服务与外部插件
DOCLING_BACKEND=disabled
DOCLING_MODEL_CACHE_ROOT=data/model-cache/docling
DOCLING_DEVICE=cpu
DOCLING_NUM_THREADS=4
DOCLING_DOCUMENT_TIMEOUT_SECONDS=120
DOCLING_PROCESS_TIMEOUT_SECONDS=150
DOCLING_PROCESS_MAX_RSS_BYTES=4294967296
DOCLING_PROCESS_MAX_SNAPSHOT_BYTES=67108864
DOCLING_OCR_ENGINE=rapidocr
DOCLING_ENABLE_REMOTE_SERVICES=false
DOCLING_ALLOW_EXTERNAL_PLUGINS=false

# M2上传合同；M2-01只声明参数，上传API从M2-06开始实现
UPLOAD_ALLOWED_EXTENSIONS=[".pdf",".docx",".xlsx",".csv"]
UPLOAD_MAX_FILE_SIZE_BYTES=26214400
UPLOAD_MAX_FILES_PER_REQUEST=5
UPLOAD_STREAM_CHUNK_SIZE_BYTES=1048576
FILE_READ_MAX_ARTIFACT_BYTES=104857600

# M2-07文本型PDF解析保护；扫描页只告警，不执行OCR
PDF_MAX_PAGES=500
PDF_MAX_EXTRACTED_CHARACTERS=5000000
PDF_LOW_TEXT_CHARACTER_THRESHOLD=20
# M2-22.4R-01 Native文本健康度：整份最低字符、有效字符比例、健康内容页比例
NATIVE_TEXT_MIN_CHARACTERS=20
NATIVE_TEXT_MIN_VALID_CHARACTER_RATIO=0.9
NATIVE_TEXT_MIN_HEALTHY_PAGE_RATIO=0.8
# M2-22.4R-04解析后门禁：70%全文保留、10字最终页、50字Native逐页证据
POST_PARSE_MIN_FINAL_NATIVE_RATIO=0.7
POST_PARSE_MIN_PAGE_CHARACTERS=10
POST_PARSE_NATIVE_PAGE_BASELINE_CHARACTERS=50
DOCX_EMPTY_OCR_MIN_IMAGE_BYTES=5120

# M2-08/R-03 DOCX解析保护；图片OCR只使用DOCLING_MODEL_CACHE_ROOT下的本地模型
DOCX_MAX_ARCHIVE_MEMBERS=5000
DOCX_IMAGE_OCR_BACKEND=rapidocr
DOCX_IMAGE_OCR_THREADS=4
DOCX_MAX_IMAGES=100
DOCX_MAX_IMAGE_BYTES=10485760
DOCX_MAX_TOTAL_IMAGE_BYTES=26214400
DOCX_MAX_IMAGE_PIXELS=20000000
DOCX_MAX_UNCOMPRESSED_BYTES=104857600
DOCX_MAX_COMPRESSION_RATIO=200
DOCX_MAX_BLOCKS=50000
DOCX_MAX_TABLE_CELLS=200000
DOCX_MAX_EXTRACTED_CHARACTERS=5000000

# M2-09 XLSX/CSV解析保护；只提取知识表格，不写商品、仓库或库存表
XLSX_MAX_ARCHIVE_MEMBERS=5000
XLSX_MAX_UNCOMPRESSED_BYTES=104857600
XLSX_MAX_COMPRESSION_RATIO=200
XLSX_MAX_SHEETS=100
XLSX_MAX_ROWS_PER_SHEET=100000
XLSX_MAX_COLUMNS=500
XLSX_MAX_CELLS=500000
XLSX_MAX_EXTRACTED_CHARACTERS=5000000
CSV_MAX_ROWS=200000
CSV_MAX_COLUMNS=500
CSV_MAX_CELLS=500000
CSV_MAX_EXTRACTED_CHARACTERS=5000000

# M2 Embedding与Reranker；Fake和只读本地缓存避免日常测试隐式下载模型
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=main
EMBEDDING_DIMENSIONS=1024
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=4
EMBEDDING_POOLING=cls
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_PRECISION=float32
RERANKER_BACKEND=fake
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANKER_BATCH_SIZE=2
RERANKER_MAX_LENGTH=8192
RERANKER_PRECISION=float32
MODEL_DEVICE=cpu
MODEL_LOCAL_FILES_ONLY=true

# M2分块与混合检索初始参数；最终值由后续评估结果调整
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
CHUNK_HEADING_CONTEXT_MAX_TOKENS=120
CHUNK_TABLE_ROW_OVERLAP=1
CHUNK_REPEATED_EDGE_MIN_PAGES=2
RETRIEVAL_QUERY_MAX_CHARACTERS=2000
DENSE_CANDIDATE_COUNT=30
LEXICAL_CANDIDATE_COUNT=30
HYBRID_CANDIDATE_COUNT=30
RRF_K=60
RERANKER_TOP_K=8

# M2-18上下文预算；仅由服务端配置，检索请求和模型都不能覆盖
CONTEXT_MAX_TOKENS=4000
CONTEXT_MAX_SEGMENTS=12
CONTEXT_NEIGHBOR_WINDOW=1
